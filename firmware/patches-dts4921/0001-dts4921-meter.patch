+  if(_rx[0] != SDM_METER_ADDRESS || _rx[1] != SDM_METER_FC || _rx[2] != 0x04 ||
      _rx[7] != (crc & 0xFF) || _rx[8] != (crc >> 8))
   {
     DBUGF("SdmMeter: bad response for reg 0x%04x", _registers[_index]);
@@ -112,7 +128,35 @@ bool SdmMeter::handleResponse()
 
   uint32_t raw = ((uint32_t)_rx[3] << 24) | ((uint32_t)_rx[4] << 16) | ((uint32_t)_rx[5] << 8) | _rx[6];
   float value;
+#ifdef METER_DTS4921
+  switch(_index) {
+    case VoltageL1:
+    case VoltageL2:
+    case VoltageL3:
+      value = (float)raw * 0.1f;
+      break;
+    case CurrentL1:
+    case CurrentL2:
+    case CurrentL3:
+      value = (float)raw * 0.001f;
+      break;
+    case PowerL1:
+    case PowerL2:
+    case PowerL3:
+    case PowerTotal:
+      value = (float)(int32_t)raw * 0.1f;
+      break;
+    case ImportEnergy:
+    case TotalEnergy:
+      value = (float)raw * 0.01f;
+      break;
+    default:
+      value = 0.0f;
+      break;
+  }
+#else
   memcpy(&value, &raw, sizeof(value));
+#endif
   if(!isnan(value)) {
     _values[_index] = value;
     _updated[_index] = millis();
